# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=8000
NODE_ENV=development

# ============================================
# DATABASE (MongoDB)
# ============================================
# Local Development:
MONGODB_URI=mongodb://localhost:27017/capstone_test

# MongoDB Atlas (Production):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/capstone_test?retryWrites=true&w=majority&replicaSet=atlas-l46ddf-shard-0
# NOTE: replicaSet parameter is REQUIRED for transactions

# ============================================
# AUTHENTICATION (JWT)
# ============================================
JWT_SECRET=your-secret-key-here-change-in-production-min-32-chars
JWT_EXPIRE=7d

# ============================================
# CORS & FRONTEND
# ============================================
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ============================================
# FILE UPLOAD (Cloudinary)
# ============================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=capstone-document

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
# Gmail SMTP (Port 465 - SSL recommended)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com

# NOTE: Use App Password for Gmail, not regular password
# Generate at: https://myaccount.google.com/apppasswords
# Enable 2FA on Gmail account first

# ============================================
# GOOGLE OAUTH
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=debug
DEBUG=false
