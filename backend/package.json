{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for Dicoding Academic Dashboard - Capstone Project",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .js --fix",
    "format": "prettier --write src",
    "db:clear": "node src/scripts/clearDatabase.js",
    "db:import": "node src/scripts/importCSV.js",
    "db:set-admin-password": "node src/scripts/setAdminPassword.js"
  },
  "keywords": [
    "express",
    "mongodb",
    "api",
    "dicoding",
    "capstone"
  ],
  "author": "Tim A25-CS246",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "fs": "^0.0.1-security",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.3",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^5.0.0",
    "nodemailer": "^7.0.10",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "path": "^0.12.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.0.4",
    "eslint": "^9.0.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.0.0",
    "supertest": "^7.1.4",
    "vitest": "^1.0.4"
  }
}
