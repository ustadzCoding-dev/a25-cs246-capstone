    {
      "name": "7. Create Team",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Build team members array with saved user IDs",
              "const userId1 = pm.collectionVariables.get('user_id_1');",
              "const userId2 = pm.collectionVariables.get('user_id_2');",
              "const userId3 = pm.collectionVariables.get('user_id_3');",
              "",
              "const teamData = {",
              "    capstoneGroupId: 'A25-CS246-TEST',",
              "    teamName: 'Tim Automated Test',",
              "    members: [",
              "        { userId: userId1, role: 'leader' },",
              "        { userId: userId2, role: 'member' },",
              "        { userId: userId3, role: 'member' }",
              "    ],",
              "    leaderId: userId1",
              "};",
              "",
              "pm.variables.set('teamData', JSON.stringify(teamData));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Team created successfully', function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.success).to.be.true;",
              "    pm.expect(response.data).to.have.property('_id');",
              "    pm.expect(response.data.status).to.eql('draft');",
              "});",
              "",
              "const response = pm.response.json();",
              "pm.environment.set('team_id', response.data._id);",
              "pm.collectionVariables.set('team_id', response.data._id);",
              "",
              "console.log('✅ Create Team: PASSED');",
              "console.log('   Team ID:', response.data._id);",
              "console.log('   Status:', response.data.status);"
            ]
          }
        }
      ],
