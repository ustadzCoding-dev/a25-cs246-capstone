{
  "info": {
    "name": "Dicoding Capstone API - Automated Tests",
    "description": "Automated API Testing for Dicoding Academic Dashboard\n\nRun this collection to test all endpoints automatically!\n\nUsage:\n1. Import this collection\n2. Click 'Run' button\n3. Select all requests\n4. Click 'Run Dicoding Capstone API'\n5. Watch tests run automatically!",
