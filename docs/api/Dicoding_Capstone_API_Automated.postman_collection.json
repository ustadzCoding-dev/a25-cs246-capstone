    {
      "name": "1. Health Check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has success field', function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.success).to.be.true;",
              "});",
              "",
              "pm.test('API is running', function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.message).to.eql('API is running');",
              "});",
              "",
              "console.log('✅ Health Check: PASSED');"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": ["{{base_url}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "2. Register Student 1 (Afrizal)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('User registered successfully', function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.success).to.be.true;",
              "    pm.expect(response.message).to.include('registered');",
              "});",
              "",
              "pm.test('Token is generated', function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.data.token).to.be.a('string');",
              "    pm.expect(response.data.token.length).to.be.above(20);",
              "});",
              "",
              "// Save token and user ID",
              "const response = pm.response.json();",
              "pm.environment.set('auth_token', response.data.token);",
              "pm.collectionVariables.set('auth_token', response.data.token);",
              "pm.environment.set('user_id_1', response.data.user._id);",
              "pm.collectionVariables.set('user_id_1', response.data.user._id);",
              "",
              "console.log('✅ Register Student 1: PASSED');",
              "console.log('   User ID:', response.data.user._id);",
              "console.log('   Token saved');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dicodingId\": \"F886D5Y0069\",\n  \"name\": \"Afrizal\",\n  \"email\": \"afrizal.test@example.com\",\n  \"password\": \"password123\",\n  \"learningPath\": \"Front-End\",\n  \"university\": \"Universitas Indonesia\"\n}"
