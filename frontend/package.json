    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.5.1",
    "happy-dom": "^20.0.10",
    "jsdom": "^27.2.0",
